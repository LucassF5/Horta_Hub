<%= form_with model: @client, local: true, class: "bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4 w-full max-w-lg" do |f| %>
<div class="mb-4">
    <%= f.label :name, "Nome", class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= f.text_field :name, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline", placeholder: "Nome do cliente" %>
</div>

<div class="mb-6">
    <%= f.label :phone, "Telefone", class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= f.telephone_field :phone, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline", placeholder: "Telefone" %>
</div>

<div class="mb-6">
    <%= f.label :client_type, "Tipo de pessoa", class: "block text-gray-700 text-sm font-bold mb-2" %>
    <%= f.select :client_type, Client.client_types.keys.map { |key| [Client.client_types[key], key] }, {}, class: "shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
</div>

<div class="flex items-center justify-between">
    <%= render RubyUI::Button.new(type: :submit) { "Salvar cliente" } %>
</div>
<% end %>