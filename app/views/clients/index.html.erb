<div class="flex-grow">
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Clientes</h1>
            <%= link_to "Novo Cliente", new_client_path, class: "bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600 transition-colors duration-300" %>
        </div>

        <% if @clients.empty? %>
        <p class="text-gray-600">Nenhum cliente cadastrado ainda.</p>
        <% else %>
        <div class="overflow-x-auto bg-white shadow-md rounded-lg">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nome</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Telefone</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% @clients.each do |client| %>
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap"><%= client.name %></td>
                        <td class="px-6 py-4 whitespace-nowrap"><%= client.phone %></td>
                        <td class="px-6 py-4 whitespace-nowrap"><%= client.client_type.humanize %></td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <div class="flex justify-end items-center gap-2">
                                <%= render LinkToComponent.new(label: "Ver", path: client_path(client), theme: :primary) %>
                                <%= render LinkToComponent.new(label: "Editar", path: edit_client_path(client), theme: :warning) %>
                                <%= button_to "Apagar", client_path(client), method: :delete, data: { confirm: "Tem certeza?" }, class: "border border-gray-200 bg-red-500 text-white px-4 py-2 rounded-md shadow-sm hover:bg-red-600 transition-colors duration-300" %>
                            </div>
                        </td>
                    </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
        <% end %>
    </div>
</div>