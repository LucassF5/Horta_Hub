<div class="container mx-auto px-4 py-8">
    <div class="bg-white shadow-md rounded-lg p-6 mb-8">
        <h1 class="text-3xl font-bold mb-6 text-gray-800"><%= @client.name %></h1>
        <p class="text-gray-700 text-lg mb-4">
            <strong class="font-semibold">Tipo do cliente:</strong> <%= @client.client_type %>
        </p>
        <% if @client.phone.present? %>
        <p class="text-gray-700 text-lg mb-4">
            <strong class="font-semibold">Telefone:</strong> <%= @client.phone %>
        </p>
        <% end %>

        <div class="flex space-x-4">
            <%= link_to "Editar", edit_client_path(@client), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            <%= button_to "Deletar", @client, method: :delete, data: { turbo_confirm: "Tem certeza que deseja deletar este cliente?" }, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
            <%= link_to "Voltar para Clientes", clients_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
    </div>
</div>