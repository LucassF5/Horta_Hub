<div class="container mx-auto px-4 py-8">
    <div class="bg-white shadow-md rounded-lg p-6 mb-8">
        <h1 class="text-3xl font-bold mb-6 text-gray-800"><%= @client.name %></h1>
        <p class="text-gray-700 text-lg mb-4">
            <strong class="font-semibold">Tipo do cliente:</strong> <%= @client.client_type %>
        </p>
        <% if @client.phone.present? %>
        <p class="text-gray-700 text-lg mb-4">
            <strong class="font-semibold">Telefone:</strong> <%= @client.phone %>
        </p>
        <% end %>

        <div class="flex gap-4">
            <%= render RubyUI::Link.new(href: edit_client_path(@client), variant: :primary) { "Editar" } %>
            <form method="post" action="<%= client_path(@client) %>" style="display: inline;" onsubmit="return confirm('Tem certeza que deseja deletar este cliente?');">
                <input type="hidden" name="_method" value="delete" />
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
                <%= render RubyUI::Button.new(type: :submit, variant: :destructive) { "Deletar" } %>
            </form>
            <%= render RubyUI::Link.new(href: clients_path, variant: :outline) { "Voltar para Clientes" } %>
        </div>
    </div>
</div>