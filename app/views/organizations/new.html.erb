<div class="mx-auto md:w-2/3 w-full">
    <h1 class="font-bold text-4xl mb-2">Criar Organização</h1>
    <p class="text-gray-600 mb-8">Crie sua organização e conta de administrador para começar.</p>

    <% if @organization.errors.any? || @user.errors.any? %>
    <div class="mb-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
        <h2 class="font-bold mb-2">Corrija os erros abaixo:</h2>
        <ul class="list-disc list-inside">
            <% @organization.errors.full_messages.each do |message| %>
            <li><%= message %></li>
            <% end %>
            <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
            <% end %>
        </ul>
    </div>
    <% end %>

    <%= form_with url: organizations_path, method: :post, class: "contents" do |form| %>

    <fieldset class="mb-8">
        <legend class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">Dados da Organização</legend>

        <div class="my-4">
            <%= form.label "organization[name]", "Nome da Organização", class: "block text-gray-700 font-bold mb-2" %>
            <%= form.text_field "organization[name]", value: @organization.name, required: true, autofocus: true, placeholder: "Ex: Horta do João", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>
    </fieldset>

    <fieldset class="mb-8">
        <legend class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">Sua Conta (Administrador)</legend>

        <div class="my-4">
            <%= form.label "user[username]", "Nome de usuário", class: "block text-gray-700 font-bold mb-2" %>
            <%= form.text_field "user[username]", value: @user.username, required: true, placeholder: "Ex: joao_silva", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>

        <div class="my-4">
            <%= form.label "user[email_address]", "Email", class: "block text-gray-700 font-bold mb-2" %>
            <%= form.email_field "user[email_address]", value: @user.email_address, required: true, autocomplete: "email", placeholder: "seu@email.com", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>

        <div class="my-4">
            <%= form.label "user[password]", "Senha", class: "block text-gray-700 font-bold mb-2" %>
            <%= form.password_field "user[password]", required: true, autocomplete: "new-password", placeholder: "Mínimo 6 caracteres", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>
    </fieldset>

    <div class="flex items-center justify-between">
        <%= render RubyUI::Button.new(type: :submit) { "Criar Organização" } %>
    </div>

    <% end %>

    <div class="mt-6 pt-6 border-t border-gray-300">
        <p class="text-sm text-gray-500">
            Já tem uma conta?
            <%= link_to "Fazer login", new_session_path, class: "text-blue-600 underline hover:no-underline" %>
        </p>
    </div>
</div>
