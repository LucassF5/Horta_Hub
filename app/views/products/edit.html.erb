<div class="mt-8 mx-auto bg-background flex flex-col justify-center items-center">
    <div class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-8">Editar Produto</h1>
        <% if @product.errors.any? %>
        <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
            <h2 class="font-bold mb-2"><%= pluralize(@product.errors.count, "error") %> prohibited this user from being saved:</h2>
            <ul class="list-disc list-inside">
                <% @product.errors.full_messages.each do |message| %>
                <li><%= message %></li>
                <% end %>
            </ul>
        </div>
        <% end %>
    </div>

    <%= render partial: "form", product: @product %>
</div>