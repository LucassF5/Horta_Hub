<div class="flex-grow">
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Produtos</h1>
            <%= link_to "Novo Produto", new_product_path, class: "bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600 transition-colors duration-300" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% @products.each do |product| %>
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <div class="p-4">
                    <h2 class="text-xl font-semibold mb-2 text-gray-800"><%= product.name %></h2>
                    <p class="text-gray-600 mb-4"><%= number_to_currency(product.price) %></p>
                    <%= link_to "Ver Detalhes", product_path(product), class: "bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600 transition-colors duration-300" %>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>