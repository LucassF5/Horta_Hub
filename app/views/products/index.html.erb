<div class="flex-grow">
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Produtos</h1>
            <%= link_to "Novo Produto", new_product_path, class: "bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600 transition-colors duration-300" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% @products.each do |product| %>
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <div class="p-4 flex flex-col justify-between h-full">
                    <div class="flex justify-between mb-2">
                        <h2 class="text-xl font-semibold text-gray-800"><%= product.name %></h2>
                        <%= render LinkToComponent.new(label: "Edit", path: edit_product_path(product), theme: :warning) %>
                        <%= button_to "Apagar", product_path(product), method: :delete, class: "border border-gray-200 bg-red-500 text-white px-4 py-2 rounded-md shadow-sm hover:bg-red-600 transition-colors duration-300"%>
                    </div>
                    <p class="text-gray-600 mb-4">Valor: <%= number_to_currency(product.price) %></p>
                    <%= render LinkToComponent.new(label: "Ver Detalhes", path: product_path(product), theme: :success)%>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>